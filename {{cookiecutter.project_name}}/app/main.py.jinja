{% set oauth_supported = cookiecutter.auth_with_google == "yes" or cookiecutter.auth_with_github == "yes" %}

from contextlib import asynccontextmanager

import sentry_sdk
from fastapi import FastAPI
{% if oauth_supported %}
from starlette.middleware.sessions import SessionMiddleware
{% endif %}

from app.api.routers import router
from app.core.config import get_settings
from app.core.exception_handlers import ExceptionHandler
from app.core.security import Security
from app.database.session import redis_client
from app.middleware import RequestIdMiddleware

SECURITY = Security()
SETTINGS = get_settings()


sentry_sdk.init(
    dsn=SETTINGS.SENTRY_SDK_DSN,
    enable_logs=True,
    traces_sample_rate=1.0,
    profiles_sample_rate=1.0,
    profile_lifecycle="trace",
)

@asynccontextmanager
async def lifespan(app: FastAPI):
    {% if oauth_supported %}
    await SECURITY.register_oauth()
    {% endif %}
    app.state.limiters = {}
    app.state.redis = redis_client

    yield

    await app.state.redis.aclose()


app = FastAPI(
    title=SETTINGS.API_TITLE,
    version=SETTINGS.API_VERSION,
    description=SETTINGS.API_DESCRIPTION,
    lifespan=lifespan
)

app.include_router(router.router)

{% if oauth_supported %}
app.add_middleware(
    SessionMiddleware,
    max_age=900,
    same_site="lax",
    secret_key=SETTINGS.SESSION_SECRET_KEY,
    https_only=SETTINGS.ENVIRONMENT == "production",
)
{% endif %}

app.add_middleware(RequestIdMiddleware)

exception_handler = ExceptionHandler(app)
exception_handler.add_handlers()


@app.get("/", status_code=200)
async def home() -> dict:
    message: dict = {
        "status": "success",
        "message": "Welcome to {{ cookiecutter.api_title }}",
    }
    return message


@app.get("/health", status_code=200)
async def health() -> dict:
    return {"status": "ok"}
