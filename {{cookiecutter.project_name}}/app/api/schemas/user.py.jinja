{% set use_google = cookiecutter.auth_with_google == "yes" %}
{% set use_github = cookiecutter.auth_with_github == "yes" %}
from datetime import datetime
from uuid import UUID

from pydantic import BaseModel, ConfigDict, EmailStr

from app.api.models.user import UserType


class UserBase(BaseModel):
    id: UUID
    type: UserType
    is_active: bool = False
    is_verified: bool = False

    model_config = ConfigDict(from_attributes=True)

{% if use_google %}

class GoogleUser(UserBase):
    google_id: str | None = None
    google_email: EmailStr | None = None
{% endif %}
{% if use_github %}

class GithubUser(UserBase):
    github_id: str | None = None
    github_email: EmailStr | None = None
{% endif %}


class EmailUser(UserBase):
    email: EmailStr | None = None


{% if use_google and use_github %}
class UserInDB(GoogleUser, GithubUser, EmailUser):
{% elif use_google %}
class UserInDB(GoogleUser, EmailUser):
{% elif use_github %}
class UserInDB(GithubUser, EmailUser):
{% else %}
class UserInDB(EmailUser):
{% endif %}
    hashed_password: str | None = None


class UserResponse(BaseModel):
    created_at: datetime

{% if use_google %}

class GoogleUserResponse(GoogleUser, UserResponse):
    pass
{% endif %}
{% if use_github %}

class GithubUserResponse(GithubUser, UserResponse):
    pass
{% endif %}


class EmailUserResponse(EmailUser, UserResponse):
    pass
